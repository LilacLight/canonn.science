{
  "name": "canonn-science",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "content": "node tools/build-content.mjs",
    "content:check": "node tools/build-content.mjs --check",
    "content:guard": "node tools/content-guard.mjs",
    "start": "npm run content && ng serve",
    "build": "npm run content && ng build && node tools/generate-share-pages.mjs",
    "test:tools": "node --test tools/test/*.test.mjs"
  },
  "dependencies": {
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "htmlparser2": "^9.1.0",
    "marked": "^12.0.2",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.35.5",
    "typescript": "~5.5.0"
  }
}
